{% extends 'base.html.twig' %}

{% block title %}Course{% endblock %}

{% block body %}
    <div class="container py-4">
        {% for message in app.flashes('course_success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('course_error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        {% if billing_unavailable %}
            <div class="alert alert-warning">Сервис временно недоступен</div>
        {% endif %}

        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
            <div>
                <h1 class="mb-2">{{ course.name }}</h1>
                <p class="mb-0">{{ course.description }}</p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary" href="{{ path('app_course_index') }}">Вернуться к списку</a>
                {% if is_granted('ROLE_SUPER_ADMIN') %}
                    <a class="btn btn-outline-primary" href="{{ path('app_course_edit', {'id': course.id}) }}">Редактировать</a>
                    <a class="btn btn-primary" href="{{ path('app_lesson_new', {'course_id': course.id}) }}">Добавить урок</a>
                {% endif %}
            </div>
        </div>

        {% if not billing_unavailable %}
            <div class="card shadow-sm mb-4">
                <div class="card-body d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                    <div>
                        <div class="small text-body-secondary mb-1">Условия доступа</div>
                        <div class="fw-semibold">
                            {% if billing_course.type == 'free' %}
                                Бесплатный курс
                            {% elseif billing_course.type == 'rent' %}
                                Аренда за {{ billing_course.price }}
                            {% else %}
                                Покупка за {{ billing_course.price }}
                            {% endif %}
                        </div>

                        {% if course_access and course_access.has_access %}
                            <div class="text-success mt-2">
                                {% if course_access.transaction and course_access.transaction.expires_at %}
                                    Арендовано до {{ course_access.transaction.expires_at|date('d.m.Y H:i') }}
                                {% else %}
                                    Куплено
                                {% endif %}
                            </div>
                        {% elseif app.user and billing_course.type != 'free' %}
                            <div class="text-body-secondary mt-2">Курс еще не оплачен.</div>
                        {% endif %}
                    </div>

                    {% if is_granted('ROLE_USER') and not is_granted('ROLE_SUPER_ADMIN') and billing_course.type != 'free' and (course_access is null or not course_access.has_access) %}
                        {% set payLabel = billing_course.type == 'rent' ? 'арендовать' : 'купить' %}
                        {% if can_afford_course %}
                            <a class="btn btn-primary" href="#" data-bs-toggle="modal" data-bs-target="#coursePayModal">{{ payLabel }}</a>
                        {% else %}
                            <button class="btn btn-primary" type="button" disabled>{{ payLabel }}</button>
                        {% endif %}
                    {% elseif not app.user and billing_course.type != 'free' %}
                        <a class="btn btn-primary" href="{{ path('app_login') }}">Войти для оплаты</a>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        <section>
            <h2 class="mb-3">Уроки</h2>

            <div class="list-group">
                {% for lesson in course.lessons %}
                    {% set canOpenLesson = not billing_unavailable and (is_granted('ROLE_SUPER_ADMIN') or (app.user and (billing_course.type == 'free' or (course_access and course_access.has_access)))) %}
                    {% if canOpenLesson %}
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3" href="{{ path('app_lesson_show', {'id': lesson.id}) }}">
                            <span>{{ lesson.name }}</span>
                            <span class="badge text-bg-secondary">Урок {{ lesson.lessonNum }}</span>
                        </a>
                    {% else %}
                        <div class="list-group-item d-flex justify-content-between align-items-center gap-3 text-body-secondary">
                            <span>{{ lesson.name }}</span>
                            <span class="badge text-bg-light border">
                                {% if app.user %}Требуется оплата{% else %}Требуется вход{% endif %}
                            </span>
                        </div>
                    {% endif %}
                {% else %}
                    <div class="list-group-item text-body-secondary">Уроков пока нет.</div>
                {% endfor %}
            </div>
        </section>

        {% if is_granted('ROLE_SUPER_ADMIN') %}
            <div class="mt-4">
                {{ include('course/_delete_form.html.twig') }}
            </div>
        {% endif %}

        {% if not billing_unavailable and is_granted('ROLE_USER') and not is_granted('ROLE_SUPER_ADMIN') and billing_course.type != 'free' and (course_access is null or not course_access.has_access) and can_afford_course %}
            <div class="modal fade" id="coursePayModal" tabindex="-1" aria-labelledby="coursePayModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title fs-5" id="coursePayModalLabel">Подтверждение оплаты</h2>
                            <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            С вашего счета будет списано {{ billing_course.price }} за курс «{{ course.name }}».
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Отмена</button>
                            <a class="btn btn-primary" href="{{ path('app_course_pay', {'id': course.id}) }}">
                                {% if billing_course.type == 'rent' %}Арендовать{% else %}Купить{% endif %}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
